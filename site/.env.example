# Optional overrides; credentials remain in the Node server.
# Root ../../.env is read locally without exposing it to the browser.
CLAUDE_API_KEY=
MISTRAL_API_KEY=
# Optional voice ID overrides. Default references in voices/ are selected by avatar.
SCRATCHXR_VOICE_PT=
SCRATCHXR_VOICE_EN=
KIMODO_DIR=
KIMODO_BACKEND=cpu
# Defaults target the CPU installation prepared by tools/install-kimodo-weights.py.
KIMODO_EXE=
KIMODO_MOTION=
KIMODO_TEXT=
KIMODO_TOOLCHAIN=C:/msys64/mingw64/bin
